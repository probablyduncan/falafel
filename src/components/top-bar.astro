<style>
    nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;

        font-family: var(--sans);
        font-weight: 600;
        font-style: italic;
        line-height: 1;

        user-select: none;
        -webkit-user-select: none;

        color: var(--color-white);
        background-color: var(--color-black);

        display: grid;
        grid-template-columns: 1fr 1fr;
        padding: 0.4em 0.5em 0.5em;
    }

    a:hover em,
    a:not(:has(em)):hover {
        text-decoration: underline;
    }

    a:has(em) :not(em) {
        opacity: 0.5;
        @media (max-width: 480px) {
            display: none;
        }
    }

    nav :last-child {
        text-align: right;
    }
</style>
