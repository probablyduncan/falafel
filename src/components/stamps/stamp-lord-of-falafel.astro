---
import { getStampStyle, getStandardImgAttributes, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    style={getStampStyle(Astro.props)}
    {...getStandardImgAttributes()}
    src="/stamps/lord.png"
    alt="An image of black text over a yellow background. The text reads: LORD OF FALAFEL."
/>

<style>
    img {
        image-rendering: pixelated;
        border: 0.2em solid #fff;
        box-shadow: 2px 2px 10px #0006;

        width: 200px;
        max-width: 30vw;
    }
</style>
