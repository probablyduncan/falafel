---
import { getStampStyle, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<div style={getStampStyle(Astro.props)}>
    LORD OF<br />
    <b>FALAFEL</b>
</div>

<style>
    div {
        font-family: var(--junicode);
        font-style: italic;
        font-size: 1.5rem;
        font-weight: 500;
        color: #230d0b;
        background-color: #ffb931;
        padding: 0.6em 0.5em 0.5em;
        line-height: 1;
        border: 0.1em solid #fff;
        box-shadow:
            0.05em 0.05em #fff,
            0.1em 0.1em #fff,
            0.15em 0.15em #fff,
            inset 0 0 0.1em #fff;
    }
</style>
