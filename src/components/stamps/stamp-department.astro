---
import { getStampStyle, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    style={getStampStyle(Astro.props)}
    src="/stamps/department.png"
    alt="An image of white text over a purple background. The text reads: FALAFEL, department of."
    draggable="false"
/>

<style>
    img {
        image-rendering: pixelated;
        border: 0.1em solid #fff;
        box-shadow:
            0.05em 0.05em #fff,
            0.1em 0.1em #fff,
            0.15em 0.15em #fff,
            inset 0 0 0.1em #fff;
        width: 200px;
        max-width: 30vw;
    }
</style>
