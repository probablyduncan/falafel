---
import { getStampStyle, getStandardImgAttributes, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    style={getStampStyle(Astro.props)}
    {...getStandardImgAttributes()}
    src="/stamps/royal.webp"
    alt="An image of black text over a yellow background, which reads: LORD OF FALAFEL."
/>

<style>
    img {
        image-rendering: pixelated;
        border: 0.1em solid #fff;
        box-shadow:
            0.05em 0.05em #fff,
            0.1em 0.1em #fff,
            0.15em 0.15em #fff,
            inset 0 0 0.1em #fff;

        width: 200px;
        max-width: 30vw;
    }
</style>
