---
import { getStampStyle, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    style={getStampStyle(Astro.props)}
    src={`favicon-frames/a32-${Math.floor(Math.random() * 6 + 1)}.png`}
    draggable="false"
/>

<style>
    img {
        width: 64px;
        image-rendering: pixelated;
        filter: drop-shadow(2px 6px 6px #0005);
    }
</style>
