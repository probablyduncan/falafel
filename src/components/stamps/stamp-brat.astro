---
import { getStampStyle, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<div style={getStampStyle(Astro.props)} class="kyroh">
    <span>falafel</span>
</div>

<style>
    div {
        background-color: #8CCF00;
        width: 5rem;
        height: 5rem;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 2px 2px 10px #0006;
        span {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 1.2rem;
            display: inline-block;
            transform: rotate(180deg) scale(0.75, 1.05);
            filter: blur(1px);
        }
    }
</style>