---
import { getStampStyle, getStandardImgAttributes, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<figure style={getStampStyle(Astro.props)}>
    <img
        {...getStandardImgAttributes()}
        src="/stamps/twin_peaks-sign-bg.png"
        alt={`"A frame of the Twin Peaks opening credits, showing the word "Falafel" instead of "Twin Peaks".`}
    />
    <img
        {...getStandardImgAttributes()}
        src="/stamps/twin_peaks-sign-title.png"
        alt={`"A frame of the Twin Peaks opening credits, showing the word "Falafel" instead of "Twin Peaks".`}
    />
</figure>

<style>
    figure {
        width: 200px;
        max-width: 30vw;
        box-shadow: 2px 2px 10px #0006;
        margin: unset;
        aspect-ratio: 4/3;
        border: 4px solid #000;
    }
    img {
        position: absolute;
        inset: 0;
        width: 100%;
        image-rendering: pixelated;
    }
    img:last-child {
        animation: fade 4s infinite forwards;
        opacity: 0;
    }
    @keyframes fade {
        0% {
            opacity: 0;
        }
        25% {
            opacity: 0;
        }
        75% {
            opacity: 1;
        }
        100% {
            opacity: 1;
        }
    }
</style>
