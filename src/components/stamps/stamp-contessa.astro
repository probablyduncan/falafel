---
import { getStampStyle, getStandardImgAttributes, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    {...getStandardImgAttributes()}
    style={getStampStyle(Astro.props)}
    src="/stamps/contessa.png"
    alt="An image of white text over a red background, which reads: Falafel Contessa."
/>

<style>
    img {
        width: 256px;
        max-width: 50vw;
        image-rendering: pixelated;

        box-shadow: -4px 4px 0 black;
    }
</style>
