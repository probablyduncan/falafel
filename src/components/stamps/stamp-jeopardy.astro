---
import { getStampStyle, type StampProps } from "../../lib/stampHelpers";

interface Props extends StampProps {}
---

<img
    style={getStampStyle(Astro.props)}
    src="/stamps/jeopardy.webp"
    alt={`A jeopardy clue card which reads: "a deep-fried ball or patty-shaped fritter of Egyptian origin".`}
    draggable="false"
/>

<style>
    img {
        image-rendering: pixelated;
        width: 200px;
        max-width: 25vw;
        box-shadow: 2px 2px 10px #0006;
    }
</style>
