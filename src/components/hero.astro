---
import { getStampComponents, getStampStyle } from "../lib/stampHelpers";
import StampContessa from "./stamps/stamp-contessa.astro";
import StampFalafelIcon from "./stamps/stamp-falafel-icon.astro";
import StampLordOfFalafel from "./stamps/stamp-lord-of-falafel.astro";
import StampTornadoFalafel from "./stamps/stamp-tornado-falafel.astro";
import StampDepartment from "./stamps/stamp-department.astro";
import StampSaintFalafel from "./stamps/stamp-saint-falafel.astro";
import StampBeholderFalafel from "./stamps/stamp-beholder-falafel.astro";
import StampBust from "./stamps/stamp-bust.astro";

const stamps = getStampComponents();
---

<header id="hero">
    <div id="title">
        <div>welcome to</div>
        <h1>planet falafel</h1>
    </div>
    <img
        id="planet-falafel"
        src="/planet-falafel.webp"
        draggable="false"
        fetchpriority="high"
        alt="An animated 3d render of a large ball of falafel being orbited by sesame seeds and other pink, red, and green ingredients."
    />
    <div id="stamp-templates">
        {stamps.map((stamp) => <stamp.component name={stamp.name} />)}
    </div>
    <div id="stamps">
        <div
            class="kyroh"
            style={getStampStyle(
                { x: -100, y: -50 },
                "font-size: 4rem; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            •*°
        </div>
        <div
            class="kyroh"
            style={getStampStyle(
                { x: 55, y: -135, r: -120 },
                "font-size: 3rem; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            •*°
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: -135, y: 45 },
                "font-size: 3rem; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            b
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: 105, y: 20 },
                "font-size: 64px; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            *
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: 75, y: -18 },
                "font-size: 64px; color: var(--color-yellow); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            w
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: -85, y: 65 },
                "font-size: 3rem; color: var(--color-yellow); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            s
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: -20, y: -65, r: -12 },
                "font-size: 2rem; color: white; filter: blur(1px); opacity: 0.8;",
            )}
        >
            🌬
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: 18, y: 62 },
                "font-size: 1rem; color: white; text-shadow: -2px -2px 20px var(--color-green); filter: blur(1px); opacity: 0.8;",
            )}
        >
            🌪
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: 80, y: -62 },
                "font-size: 1rem; color: white; text-shadow: -2px -2px 20px var(--color-green); filter: blur(1px); opacity: 0.8;",
            )}
        >
            🕊
        </div>
        <div
            style={getStampStyle(
                { x: -66, y: -41 },
                "font-size: 2rem; color: var(--color-yellow); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            ⸙
        </div>
        <div
            style={getStampStyle(
                { x: 90, y: 60, r: 20 },
                "font-size: 1.5rem; color: var(--color-green); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            ⸙
        </div>
        <div
            class="kyroh alts"
            style={getStampStyle(
                { x: 120, y: -75, r: -12 },
                "font-size: 2rem; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            0
        </div>
        <div
            style={getStampStyle(
                { x: 45, y: -55, r: -12 },
                "font-size: 2rem; color: var(--color-yellow); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            فلافل
        </div>
        <div
            style={getStampStyle(
                { x: -60, y: 105, r: -12 },
                "font-size: 1.5rem; color: var(--color-red); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            طعمية
        </div>
        <div
            style={getStampStyle(
                { x: -58, y: 40, r: -12 },
                "font-size: 2rem; color: var(--color-blue); text-shadow: -2px -2px 20px currentColor; filter: blur(1px); opacity: 0.8;",
            )}
        >
            ♔
        </div>
        <StampFalafelIcon y={20} x={-100} />
        <StampFalafelIcon y={-100} x={30} />
        <StampFalafelIcon y={130} x={-40} />
        <StampFalafelIcon y={-5} x={120} />
        <StampTornadoFalafel y={48} x={51} r={-6} />
        <StampContessa y={50} x={-40} r={18} />
        <StampLordOfFalafel y={-200} x={300} r={8} />
        <StampDepartment y={-30} x={-75} r={-10} />
        <StampSaintFalafel y={-55} x={45} r={12} />
        <StampLordOfFalafel y={-130} x={-30} r={8} />
        <StampBeholderFalafel y={120} x={30} r={-5} />
        <StampBust y={-40} x={64} r={8} />
    </div>
</header>

<style>
    #hero {
        width: 100%;
        height: 100svh;

        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: clip;
        background:
            radial-gradient(closest-side, #442a2d, #210c0c),
            url("/map_bg-static_3.png");
        background-blend-mode: hard-light;
        image-rendering: pixelated;

        border-bottom: 0.25rem groove var(--color-yellow);

        /* raw units, shouldn't use these */
        /* --planet-img-width: min(512px, 64vw); */
        /* --planet-font-size: min(64px, 8vw); */
        /* --stamp-position-unit: min(10.24px, 1.28vw); */

        --hero-base-unit: min(64px, 8vw);

        --planet-font-size: var(--hero-base-unit);
        --planet-img-width: calc(var(--hero-base-unit) * 8);

        /* 0-100 corresponds to 0-512px at 1024px screen width */
        --stamp-position-unit: calc(var(--hero-base-unit) / 6.25);
    }

    #planet-falafel {
        position: absolute;
        bottom: 50%;
        left: 50%;
        transform: translate(-50%, 50%);
        width: var(--planet-img-width);
        aspect-ratio: 1;
        animation: float 2s ease-in-out infinite alternate;
        user-select: none;
        -webkit-user-select: none;
        pointer-events: none;
        transition: opacity 0.5s;
    }

    @keyframes float {
        0% {
            transform: translate(-50%, calc(50% - 5px));
        }
        100% {
            transform: translate(-50%, calc(50% + 5px));
        }
    }

    #title {
        color: var(--color-yellow);
        font-family: var(--kyroh);
        font-size: var(--planet-font-size);
        font-weight: bold;
        text-shadow: 0 0 10px var(--color-yellow);
        filter: blur(1px);
        line-height: 1;
        display: flex;
        flex-direction: column;
        align-items: center;

        &,
        & * {
            user-select: none;
            -webkit-user-select: none;
        }

        div {
            font-size: 0.33333333em;
        }
    }

    #hero:has(#title > *:hover) #planet-falafel {
        opacity: 0.5;
    }

    /* :where() forces lower specificity than stamp component styles */
    :where(#stamps) > :global(*) {
        /* initial position */
        --yi: 0;
        --xi: 0;

        /* initial rotation */
        --r: 0deg;

        /* grab transform position */
        --dx: 0px;
        --dy: 0px;

        /* scale */
        --s: 1;

        position: absolute;
        top: calc(50% + var(--stamp-position-unit) * var(--yi) / 2);
        left: calc(50% + var(--stamp-position-unit) * var(--xi) / 2);
        z-index: 2;

        white-space: pre;

        /*
            so I need these to be in the context of the hero unit
            maybe I should lerp it so it's 0-1 from center to edge of planet
            and then 1+ is to left or right of planet?
            but then ofc the vertical scale is different, maybe that can also be in terms of the planet
            the falafel planet is about half the size of the planet image, fyi
        */

        transform: translate(calc(var(--dx) - 50%), calc(var(--dy) - 50%))
            rotate(var(--r)) scale(var(--s));

        user-select: none;
        -webkit-user-select: none;

        cursor: grab;

        /* touches that start on a stamp drag it instead of scrolling the page */
        touch-action: none;
        -webkit-touch-callout: none;
    }

    #stamps > :global(.active) {
        --s: 1.05;
    }

    #hero:has(#stamps > :global(.active)),
    #stamps > :global(.active) {
        cursor: grabbing;
    }

    #stamp-templates {
        display: none;
        visibility: hidden;
    }
</style>

<script>
    import { AnimationController } from "../lib/animationController";
    import { Lerp } from "../lib/lerp";

    /** touch/pen movement under this (px) still counts as a tap */
    const TAP_SLOP_PX = 10;

    function initStamps() {
        const heroContainer = document.getElementById("hero")!;
        const stampTemplates = document.querySelectorAll(
            "#stamp-templates > :not(script, style)",
        );
        const stampContainer = document.getElementById("stamps")!;

        if (!heroContainer || !stampContainer || !stampTemplates?.length) {
            return;
        }

        interface StampState {
            element: HTMLElement;
            x: Lerp;
            y: Lerp;
            isDragging: boolean;
            deactivateTimeoutId?: ReturnType<typeof setTimeout>;
        }

        const stamps: Record<string, StampState> = {};

        // stamps that are being dragged, or are still catching up to the pointer
        const animating = new Set<StampState>();

        const animationController = new AnimationController(({ delta }) => {
            for (const state of animating) {
                state.x.step(delta);
                state.y.step(delta);

                state.element.style.setProperty(
                    "--dx",
                    `${state.x.current.toFixed(5)}px`,
                );
                state.element.style.setProperty(
                    "--dy",
                    `${state.y.current.toFixed(5)}px`,
                );

                if (!state.isDragging && state.x.isAtRest() && state.y.isAtRest()) {
                    animating.delete(state);
                    onAnimationStop(state);
                }
            }

            // keep running until every stamp has settled
            return animating.size > 0;
        });

        for (let i = 0; i < stampContainer.children.length; i++) {
            const stamp = stampContainer.children[i] as HTMLElement;
            if (stamp) {
                addStampToState(stamp);
            }
        }

        function createLerp(value: number) {
            const lerp = new Lerp(50);
            lerp.reset(value);
            return lerp;
        }

        function addStampToState(
            element: HTMLElement,
            x: number = 0,
            y: number = 0,
        ) {
            if (!element.id) {
                element.id = `stamp-${Object.keys(stamps).length}`;
            }
            stamps[element.id] = {
                element,
                x: createLerp(x),
                y: createLerp(y),
                isDragging: false,
            };
        }

        function onAnimationStop(state: StampState) {
            clearTimeout(state.deactivateTimeoutId);
            state.deactivateTimeoutId = setTimeout(() => {
                state.element.classList.remove("active");
            }, 166.6666666667);
        }

        function moveToFront(el: Node) {
            // this is complicated because if we just do el.parentElement.appendChild(el),
            // moving the el to the end of the parent, it cancels :active styles
            let nextSibling = el.nextSibling;
            while (nextSibling) {
                const siblingToMove = nextSibling;
                nextSibling = nextSibling.nextSibling;
                el.parentElement!.insertBefore(siblingToMove, el);
            }
        }

        let recentStampTemplateIndices: number[] = Array(
            Math.floor(stampTemplates.length / 2),
        ).fill(-1);

        function getRandomStamp() {
            let nextStampTemplateIndex: number;
            do {
                nextStampTemplateIndex = Math.floor(
                    Math.random() * stampTemplates.length,
                );
            } while (recentStampTemplateIndices.includes(nextStampTemplateIndex));
            recentStampTemplateIndices.shift();
            recentStampTemplateIndices.push(nextStampTemplateIndex);
            return stampTemplates[nextStampTemplateIndex].cloneNode(
                true,
            ) as HTMLElement;
        }

        function createNewStamp(e: { clientX: number; clientY: number }) {
            const stamp = getRandomStamp();

            const rotationRandomComponent = Math.random() * 0.5 - 0.15;
            const vectorFromCenter = [
                e.clientX + window.scrollX - heroContainer.clientWidth / 2,
                e.clientY + window.scrollY - heroContainer.clientHeight / 2,
            ];
            const tilt = Math.sign(vectorFromCenter[0] * -vectorFromCenter[1]);
            stamp.style.setProperty(
                "--r",
                `${tilt * rotationRandomComponent}rad`,
            );

            // const angleToCenter =
            //     Math.atan2(vectorFromCenter[1], -vectorFromCenter[0]) + Math.PI;
            // const circleTiltAmount = Math.abs(Math.cos(angleToCenter));
            // const xCenterLerp =
            //     1 -
            //     Math.abs((vectorFromCenter[0] / heroContainer.clientWidth) * 2);
            // stamp.style.setProperty(
            //     "--r",
            //     `${(circleTiltAmount * xCenterLerp + rotationRandomComponent) * tilt}rad`,
            // );

            stampContainer.appendChild(stamp);
            addStampToState(stamp, ...vectorFromCenter);
            stamp.style.setProperty("--dx", `${vectorFromCenter[0]}px`);
            stamp.style.setProperty("--dy", `${vectorFromCenter[1]}px`);
            return stamp;
        }

        /**
         * A press on empty space with touch or pen might be the start of a page
         * scroll, so those spawn a stamp on tap instead of on press: the stamp
         * appears on release, unless the browser took over for a scroll
         * (pointercancel) or the pointer moved too far to be a tap.
         */
        function spawnStampOnTap(eDown: PointerEvent) {
            const abortController = new AbortController();
            const { signal } = abortController;

            document.addEventListener(
                "pointermove",
                (eMove) => {
                    if (eMove.pointerId !== eDown.pointerId) return;
                    if (
                        Math.hypot(
                            eMove.clientX - eDown.clientX,
                            eMove.clientY - eDown.clientY,
                        ) > TAP_SLOP_PX
                    ) {
                        abortController.abort();
                    }
                },
                { signal },
            );

            function onPointerEnd(eEnd: PointerEvent) {
                if (eEnd.pointerId !== eDown.pointerId) return;
                abortController.abort();

                if (eEnd.type === "pointerup") {
                    const stamp = createNewStamp(eDown);

                    // same little pop as a mouse press, then settle
                    stamp.classList.add("active");
                    onAnimationStop(stamps[stamp.id]);
                }
            }

            document.addEventListener("pointerup", onPointerEnd, { signal });
            document.addEventListener("pointercancel", onPointerEnd, {
                signal,
            });
        }

        heroContainer.addEventListener("pointerdown", (eDown) => {
            // left mouse button, or a touch/pen contact (ignores extra fingers)
            if (eDown.button !== 0 || !eDown.isPrimary) {
                return;
            }

            const target = eDown.target as HTMLElement;
            let stamp = target.closest("#stamps > *") as HTMLElement;

            // don't spawn on text/clickable elements
            if (
                !stamp &&
                target.closest("a, button, span:not(:has(*)), #bottom-bar")
            ) {
                return;
            }

            // get or create stamp
            if (stamp) {
                moveToFront(stamp);
            } else {
                // don't spawn on refocus clicks
                if (!document.hasFocus()) {
                    return;
                }

                if (eDown.pointerType !== "mouse") {
                    spawnStampOnTap(eDown);
                    return;
                }
                stamp = createNewStamp(eDown);
            }
            const state = stamps[stamp.id];

            // for cancelling listeners
            const abortController = new AbortController();
            const { signal } = abortController;

            // prevent dragging, etc
            eDown.preventDefault();
            document.addEventListener("selectstart", (e) => e.preventDefault(), {
                signal,
            });
            document.addEventListener("dragstart", (e) => e.preventDefault(), {
                signal,
            });

            // keep receiving move/up events if the pointer leaves the window
            heroContainer.setPointerCapture(eDown.pointerId);

            // state things
            const lastScroll = [window.scrollX, window.scrollY];
            const dragStart = [
                eDown.clientX + window.scrollX - state.x.current,
                eDown.clientY + window.scrollY - state.y.current,
            ];

            document.addEventListener(
                "pointermove",
                (eMove) => {
                    if (eMove.pointerId !== eDown.pointerId) return;

                    state.x.target =
                        eMove.clientX + window.scrollX - dragStart[0];
                    state.y.target =
                        eMove.clientY + window.scrollY - dragStart[1];
                },
                { signal },
            );

            document.addEventListener(
                "scroll",
                () => {
                    state.x.target += window.scrollX - lastScroll[0];
                    state.y.target += window.scrollY - lastScroll[1];
                    lastScroll[0] = window.scrollX;
                    lastScroll[1] = window.scrollY;
                },
                { signal },
            );

            function onDragStart() {
                clearTimeout(state.deactivateTimeoutId);
                state.element.classList.add("active");
                state.isDragging = true;

                // grabbing a stamp mid-glide stops it where it is
                state.x.target = state.x.current;
                state.y.target = state.y.current;

                animating.add(state);
                animationController.playIfPaused();
            }

            function onDragStop(eEnd: PointerEvent) {
                if (eEnd.pointerId !== eDown.pointerId) return;
                abortController.abort();

                // the stamp keeps gliding until it reaches the last target,
                // then the animation loop removes it
                state.isDragging = false;
            }

            document.addEventListener("pointerup", onDragStop, { signal });
            document.addEventListener("pointercancel", onDragStop, { signal });
            onDragStart();
        });
    }

    document.addEventListener("DOMContentLoaded", initStamps);
</script>