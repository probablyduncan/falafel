---
import WrapMap from "./wrap-map.astro";
import { getDateEatenText } from "../lib/dateHelpers";
import getFalafel from "../lib/falafelLoader";
import { getOrdinal } from "../lib/textHelpers";

const falafel = getFalafel();

//             ..-. .- .-.. .- ..-. . .-..
const morse = "ssls sl slss sl ssls s slss"
    .replaceAll(" ", " ")
    .replaceAll("s", "-")
    .replaceAll("l", "—");

const aboutHref = new URL("about", Astro.site).toString();
---

<main class="wrapper">
    <div class="list">
        <div class="text">
            <h2>
                These are all the places that I have <strong
                    >*Eaten Falafel*</strong
                >
            </h2>
            <p>
                Welcome to <strong>falafel.fyi</strong>, a weird little
                microblog about my favorite kind of ball. Every time I order a <em
                    >falafel wrap</em
                > from a new cart, cafe, or restaurant, I write a little review, and
                put it here.
            </p>
            <p>
                There are currently <strong>{falafel.length} (!)</strong> of them.
            </p>
            <p>
                For <em>more information</em> about my love of falafel wraps, why
                they’re all rated five stars, and how I built this website, navigate
                your <em>internet browser</em> to <a
                    href="/about"
                    title={aboutHref}>{aboutHref}</a
                >.
            </p>
            <p>
                If you prefer Google Maps, these reviews are also available as <span
                    class="nowrap"
                    >a <a
                        href={falafel.googleMapsUri}
                        title={`view the Wraps / in Google Maps`}
                        target="_blank">saved list</a
                    >.</span
                >
            </p>
            <p>Enjoy your stay!</p>
            <ul>
                {
                    falafel.entryArr
                        .slice(0, falafel.length)
                        .map((entry, index) => {
                            const number = falafel.length - index;
                            const numberText = (falafel.length - index)
                                .toString()
                                .padStart(
                                    1 + Math.floor(Math.log10(falafel.length)),
                                    "0",
                                );
                            const ordinalText = getOrdinal(number);
                            const dateEatenText = getDateEatenText(entry);
                            return (
                                <li
                                    id={entry.cacheKey}
                                    data-entry={number}
                                    title={`click to see ${entry.name} on the map!`}
                                >
                                    <div
                                        class="morse kyroh"
                                        role="presentation"
                                    >
                                        {morse} {morse} {morse} {morse} {morse}
                                    </div>
                                    <div class="entry-header">
                                        <div
                                            class="number"
                                            title={`the ${number}${ordinalText} wrap!`}
                                        >
                                            #{numberText}
                                        </div>
                                        <div class="row">
                                            <h3 class="name">{entry.name}</h3>
                                        </div>
                                        <div class="row">
                                            <a
                                                href={entry.googleMapsUri}
                                                class="address"
                                                title={entry.address}
                                                target="_blank"
                                            >
                                                {entry.address
                                                    ?.split(" ")
                                                    .at(-1)}
                                            </a>
                                            <div
                                                class="stars"
                                                title="five stars!"
                                            >
                                                ⭐⭐⭐⭐⭐
                                            </div>
                                        </div>
                                    </div>
                                    <div class="entry-body">
                                        {entry.review
                                            .split("\n")
                                            .filter(Boolean)
                                            .map((p) => (
                                                <p>
                                                    {p
                                                        .split(entry.name)
                                                        .map((p, i) => (
                                                            <>
                                                                {i > 0 && (
                                                                    <strong>
                                                                        {
                                                                            entry.name
                                                                        }
                                                                    </strong>
                                                                )}
                                                                {p}
                                                            </>
                                                        ))}
                                                </p>
                                            ))}
                                        <p class="date">
                                            <>
                                                <span>First eaten: </span>
                                                <em>{dateEatenText}</em>.
                                            </>
                                        </p>
                                    </div>
                                </li>
                            );
                        })
                }
            </ul>
        </div>
    </div>
    <div class="panel">
        <div class="grab-bar"></div>
        <WrapMap class="map" />
    </div>
</main>

<style>
    .wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100lvh;
        border-top: 2px solid var(--color-map);

        --map-open: 0;
        --map-height: calc((30 + 35 * var(--map-open)) * 1lvh);
    }

    .list {
        min-width: 0;
    }

    li {
        scroll-margin-top: var(--pad);
    }

    .panel {
        position: sticky;
        bottom: 0;
        z-index: 4;
        margin-top: 60vw;
        height: var(--map-height);
        transition: height 0.2s;
    }

    .map {
        width: 100%;
        height: 100%;
    }

    .grab-bar {
        position: absolute;
        inset-inline: 0;
        bottom: calc(100% - 1rem);
        z-index: 1;
        height: 4rem;
        display: grid;
        place-items: center;
        cursor: grab;
        touch-action: none;
        background: linear-gradient(
            to top,
            var(--color-white) 50%,
            transparent 100%
        );
        border-radius: 0 0 1rem 1rem;
    }

    .grab-bar::after {
        content: "";
        width: min(50%, 8rem);
        height: 0.5rem;
        border-radius: 0.5rem;
        background-color: var(--color-green);
    }

    .text {
        padding: 1rem;
    }

    h2 {
        font-size: 10vw;
        font-weight: bold;
        text-align: center;
        text-wrap: balance;
        margin-block: 2rem;
    }

    h2,
    p {
        strong {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: var(--yellow-shadow);
        }

        em {
            font-weight: bold;
            font-style: normal;
        }

        a {
            text-decoration: underline;
            text-decoration-thickness: 2px;
        }

        a:hover,
        a:focus-visible {
            text-decoration: none;
            background-color: var(--color-black);
            color: var(--color-white);
            outline: 0.1em solid var(--color-black);
            outline-offset: 0;
            border-radius: 0.1em;
        }

        &:has(a:hover, a:focus-visible)::after {
            content: "→";
            font-family: var(--kyroh);
            font-size: 1.5em;
            display: inline-block;
            transform: translate(0.14em, 0.27em) rotate(-30deg);
            line-height: 0;
            width: 0;
            height: 0;
        }

        .nowrap {
            white-space: pre;
        }
    }

    h2 + p::before {
        content: "";
        background-image: url("/falafel_stamp.png");
        background-size: contain;
        image-rendering: pixelated;
        filter: drop-shadow(0.05em 0.1em 0 #0004) drop-shadow(0 0.1em 2px #0004)
            drop-shadow(0.05em 0 2px #0004);
        display: inline-block;
        width: 0.8em;
        aspect-ratio: 1;
        margin-right: 3em;
        transform: translateY(0.05em);
    }

    h2 ~ p:last-of-type::after {
        content: "w";
        font-family: var(--kyroh);
        font-feature-settings: "ss01";
        margin-left: 1em;
        text-shadow: 0.04em 0.08em 0 var(--color-yellow);
    }

    /* Entries */
    ul {
        list-style: none;
        padding: unset;
    }

    .morse {
        white-space: pre;
        overflow-x: clip;
        margin-block: 2em 1em;
        font-size: 1.2em;
    }

    .entry-header {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: end;
        line-height: 1;
    }

    .row {
        display: flex;
        justify-content: space-between;
        align-items: end;
    }

    .number {
        grid-row: span 2;
        margin-top: -0.05em;
        margin-right: 0.25em;
        font-size: 2.4em;
        font-weight: bold;
        font-feature-settings: "tnum";
        text-shadow: var(--yellow-shadow);
    }

    .name {
        font-weight: bold;
        text-wrap: balance;
    }

    .address {
        font-style: italic;
    }

    .stars {
        display: none;
    }

    .entry-body {
        text-wrap: pretty;

        p:first-of-type::before {
            content: "→";
            font-family: var(--kyroh);
            margin-right: 1.4em;
        }
    }

    .date {
        text-align: right;
        opacity: 0.65;

        span {
            font-style: italic;
        }
    }

    @media (min-aspect-ratio: 1) {
        .wrapper {
            --pad: 1rem;
            --header-height: 1.9rem;

            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--pad);
            padding: var(--pad);
        }

        .list {
            grid-column: 2;
        }

        li {
            scroll-margin-top: 0;
        }

        .panel {
            grid-column: 1;
            grid-row: 1;
            top: calc(var(--header-height) + var(--pad));
            bottom: auto;
            height: calc(100lvh - var(--header-height) - 2 * var(--pad));
            margin-top: 0;
        }

        .map {
            border: 4px solid var(--color-black);
            border-radius: var(--pad);
        }

        .grab-bar {
            display: none;
        }

        .text {
            padding: 0;
        }

        h2 {
            font-size: 3.14vw;
            text-align: left;
        }
    }
</style>

<script>
    import {
        addMapFalafelClickListener,
        focusMapFalafel,
    } from "../lib/mapEvents";

    function initList() {
        const wrapper = document.querySelector(".wrapper") as HTMLElement;
        const grabBar = document.querySelector(".grab-bar") as HTMLElement;

        function toggleMap(shouldBeOpen?: boolean) {
            shouldBeOpen ??=
                wrapper.style.getPropertyValue("--map-open") !== "1";
            wrapper.style.setProperty("--map-open", shouldBeOpen ? "1" : "0");
        }

        // change map size on grab bar click
        grabBar.addEventListener("click", () => toggleMap());

        // focus map on falafel when an entry is clicked
        document.querySelectorAll("[data-entry]").forEach((e) => {
            e.addEventListener("click", () => {
                focusMapFalafel(e.id);
            });
        });

        // scroll to entry when map falafel is clicked
        addMapFalafelClickListener((id: string) => {
            const el = document.getElementById(id);
            if (!el) return;

            el.scrollIntoView({ behavior: "instant" });
            toggleMap(false);
        });

        // scroll to top when top button is clicked
        document.querySelectorAll("[data-top]").forEach((e) => {
            e.addEventListener("click", () => {
                wrapper.scrollIntoView();
            });
        });
    }

    document.addEventListener("DOMContentLoaded", initList);
</script>