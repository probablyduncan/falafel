---
import WrapMap from "./wrap-map.astro";
import { getDateEatenText } from "../lib/dateHelpers";
import getFalafel from "../lib/falafelLoader";
import { getOrdinal } from "../lib/textHelpers";

const falafel = getFalafel();

//             ..-. .- .-.. .- ..-. . .-..
const morse = "ssls sl slss sl ssls s slss"
    .replaceAll(" ", " ")
    .replaceAll("s", "-")
    .replaceAll("l", "—");

const aboutHref = new URL("about", Astro.site).toString();
---

<div class="wide-bar"></div>
<main class="wrapper">
    <div class="list">
        <div class="text">
            <h2>
                These are all the places that I have <strong
                    >“Eaten Falafel”</strong
                >
            </h2>
            <p>
                Welcome to <strong>falafel.fyi</strong>, a weird little
                microblog about my favorite kind of ball. Every time I order a <em
                    >falafel wrap</em
                > from a new cart, cafe, or restaurant, I write a little review, and
                put it here.
            </p>
            <p>
                There are currently <strong>{falafel.length} (!)</strong> of them.
            </p>
            <p>
                For <em>more information</em> about my love of falafel wraps, why
                they’re all rated five stars, and how I built this website, navigate
                your <em>internet browser</em> to <a
                    href="/about"
                    title={aboutHref}>{aboutHref}</a
                >.
            </p>
            <p>
                If you prefer Google Maps, these reviews are also available as <span
                    class="nowrap"
                    >a <a
                        href={falafel.googleMapsUri}
                        title={`view the Wraps / in Google Maps`}
                        target="_blank">saved list</a
                    >.</span
                >
            </p>
            <p>Enjoy your stay!</p>
            <ul>
                {
                    falafel.entryArr
                        .slice(0, falafel.length)
                        .map((entry, index) => {
                            const number = falafel.length - index;
                            const numberText = (falafel.length - index)
                                .toString()
                                .padStart(
                                    1 + Math.floor(Math.log10(falafel.length)),
                                    "0",
                                );
                            const ordinalText = getOrdinal(number);
                            const dateEatenText = getDateEatenText(entry);
                            return (
                                <li
                                    id={entry.cacheKey}
                                    data-entry={number}
                                    title={`click to see ${entry.name} on the map!`}
                                >
                                    <div
                                        class="morse kyroh"
                                        role="presentation"
                                    >
                                        {morse} {morse} {morse} {morse} {morse}
                                    </div>
                                    <div class="entry-header">
                                        <div class="number" title={`the ${number}${ordinalText} wrap!`}>[{numberText}]</div>
                                        <div class="row">
                                            <h3 class="name">{entry.name}</h3>
                                        </div>
                                        <div class="row">
                                            <div
                                                class="address"
                                                title={entry.address}
                                            >
                                                {entry.address
                                                    ?.split(" ")
                                                    .at(-1)}
                                            </div>
                                            <div
                                                class="stars"
                                                title="five stars!"
                                            >
                                                ⭐⭐⭐⭐⭐
                                            </div>
                                        </div>
                                    </div>
                                    <div class="entry-body">
                                        {entry.review
                                            .split("\n")
                                            .filter(Boolean)
                                            .map((p) => (
                                                <p>
                                                    {p
                                                        .split(entry.name)
                                                        .filter(Boolean)
                                                        .map((p, i) => (
                                                            <>
                                                                {i > 0 && (
                                                                    <strong>
                                                                        {
                                                                            entry.name
                                                                        }
                                                                    </strong>
                                                                )}
                                                                {p}
                                                            </>
                                                        ))}
                                                </p>
                                            ))}
                                        <p class="date">
                                            <>
                                                <span>First eaten: </span>
                                                <em>{dateEatenText}</em>.
                                            </>
                                        </p>
                                    </div>
                                </li>
                            );
                        })
                }
            </ul>
        </div>
    </div>
    <div class="grab-bar"></div>
    <WrapMap class="map" />
</main>

<style>
    .wrapper {
        border-top: 2px solid var(--color-map);
        min-height: 100lvh;
        position: relative;
        --map-open: 0;
        --map-top: 1.9rem;
        /* --map-top: 0rem; */
        --map-height: calc(1lvh * (var(--map-open) * 35 + 30) - var(--map-top));
        --grab-bar-overhang: 1rem;
        --grab-bar-height: calc(var(--grab-bar-overhang) + 3rem);
    }

    .map {
        height: var(--map-height);
        transition: height 0.2s;
        width: 100%;
        position: sticky;
        bottom: 1.9rem;
        z-index: 4;
        margin-top: calc(-1 * var(--grab-bar-overhang));
        margin-top: calc(100lvh - var(--map-height) - var(--grab-bar-overhang));
    }

    .list {
        z-index: 3;
        min-width: 0;
        position: relative;
        margin-bottom: -1rem;
    }

    .wide-bar {
        width: 100%;
        position: fixed;
        height: 1.9rem;
        background-color: var(--color-black);
        bottom: 0;
        z-index: 10;
    }

    .grab-bar {
        cursor: grab;
        touch-action: pan-y;
        z-index: 5;
        width: 100%;
        height: var(--grab-bar-height);
        background: linear-gradient(
            to top,
            var(--color-white) 50%,
            transparent 100%
        );
        position: sticky;
        bottom: calc(
            var(--map-height) + var(--map-top) - var(--grab-bar-overhang)
        );
        transition: bottom 0.2s;
        border-bottom-left-radius: 1rem;
        border-bottom-right-radius: 1rem;
        margin-top: calc(100lvh - var(--map-height) - var(--grab-bar-height));
    }

    .grab-bar::after {
        content: "";
        --bar-width: min(50%, 8rem);
        width: var(--bar-width);
        height: 0.5rem;
        border-radius: 0.5rem;
        background-color: var(--color-green);
        position: absolute;
        top: calc(50% - 0.25rem);
        left: calc(50% - var(--bar-width) / 2);
    }

    .text {
        padding: 1rem;
    }

    h2 {
        font-weight: bold;
        text-wrap: balance;

        font-size: 10vw;
        text-align: center;
        margin-block: 2rem;
    }

    h2,
    p {
        strong {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: var(--yellow-shadow);
        }

        em {
            font-weight: bold;
            font-style: normal;
        }

        a {
            text-decoration: underline;
            text-decoration-thickness: 2px;
        }

        a:hover,
        a:focus-visible {
            text-decoration: none;
            background-color: var(--color-black);
            color: var(--color-white);
            outline: auto var(--color-black);
            border-radius: 0.1em;
        }

        &:has(a:hover, a:focus-visible)::after {
            content: "→";
            font-family: var(--kyroh);
            font-size: 1.5em;
            display: inline-block;
            transform: translate(0.14em, 0.27em) rotate(-30deg);
            line-height: 0;
            width: 0;
            height: 0;
        }

        .nowrap {
            white-space: pre;
        }
    }

    h2 + p::before {
        content: "";
        background-image: url("/falafel_stamp.png");
        background-size: contain;
        image-rendering: pixelated;
        filter: drop-shadow(0.05em 0.1em 0 #0004) drop-shadow(0 0.1em 2px #0004)
            drop-shadow(0.05em 0 2px #0004);
        display: inline-block;
        width: 0.8em;
        aspect-ratio: 1;
        margin-right: 3em;
        transform: translateY(0.05em);
    }

    h2 ~ p:last-of-type::after {
        content: "w";
        text-align: right;
        /* float: right; */
        font-family: var(--kyroh);
        font-feature-settings: "ss01";
        margin-left: 1em;
        text-shadow: 0.04em 0.08em 0 var(--color-yellow);
    }

    ul {
        list-style: none;
        padding: unset;
    }

    .morse {
        white-space: pre;
        overflow-x: clip;
        text-overflow: clip;
        margin-top: 2em;
        margin-bottom: 1em;
        font-size: 1.2em;
    }

    .entry-header {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(2, auto);
        align-items: end;
        line-height: 1;
    }

    .entry-header > div {
        display: flex;
        justify-content: space-between;
        align-items: end;
    }

    .number {
        font-size: 2.4em;
        font-weight: bold;
        margin-right: 0.25em;
        margin-top: -0.05em;
        font-feature-settings: "tnum";
        grid-row-start: 1;
        grid-row-end: 3;
        text-shadow: var(--yellow-shadow);

        sup {
            margin-bottom: 1em;
            font-size: 0.5em;
        }
    }

    .name {
        font-weight: bold;
        text-wrap: balance;
        text-wrap: balance;
    }

    .address {
        font-style: italic;
    }

    .stars {
        display: none;
    }

    .stars,
    .date {
        text-align: right;
    }

    .date {
        opacity: 0.65;
        span {
            font-style: italic;
        }
        em {
            font-weight: bold;
        }
    }

    .entry-body {
        text-wrap: pretty;
        /* text-align: justify;
        -webkit-hyphens: auto;
        -moz-hyphens: auto;
        -ms-hyphens: auto;
        hyphens: auto; */

        p:first-of-type::before {
            content: "→";
            font-family: var(--kyroh);
            margin-right: 1.4em;
        }
    }

    @media (min-aspect-ratio: 1) {
        .wrapper {
            --padding: 1rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--padding);
            padding: var(--padding);
            --map-height: 100%;
            --grab-bar-overhang: 0rem;
            --grab-bar-height: 0rem;
        }

        h2 {
            font-size: 3.14vw;
            text-align: left;
        }

        .grab-bar {
            display: none;
        }

        nav {
            display: none;
        }

        .map {
            grid-column: 1;
            grid-row: 1;
            bottom: unset;
            top: 2.9rem;
            height: calc(100lvh - 2 * var(--padding) - 1.9rem);
            border-radius: var(--padding);
            box-shadow:
                4px 4px 20px #0002,
                -2px 2px 12px #0002,
                0 0 4px #0002;
            margin-top: unset;
        }

        .list {
            grid-column: 2;
        }

        .text {
            padding: unset;
        }

        .wide-bar {
            display: none;
        }
    }
</style>

<script>
    import {
        addMapFalafelClickListener,
        focusMapFalafel,
    } from "../lib/mapEvents";

    function initList() {
        const wrapper = document.querySelector(".wrapper") as HTMLElement;
        const grabBar = document.querySelector(".grab-bar") as HTMLElement;

        function toggleMap(shouldBeOpen?: boolean) {
            shouldBeOpen ??=
                wrapper.style.getPropertyValue("--map-open") !== "1";
            wrapper.style.setProperty("--map-open", shouldBeOpen ? "1" : "0");
        }

        // change map size on grab bar click
        grabBar.addEventListener("click", () => toggleMap());

        // focus map on falafel when an entry is clicked
        document.querySelectorAll("[data-entry]").forEach((e) => {
            e.addEventListener("click", () => {
                focusMapFalafel(e.id);
            });
        });

        // scroll to entry when map falafel is clicked
        addMapFalafelClickListener((id: string) => {
            const el = document.getElementById(id);
            if (!el) return;

            el.scrollIntoView({ behavior: "instant" });
            toggleMap(false);
        });

        // scroll to top when top button is clicked
        document.querySelectorAll("[data-top]").forEach((e) => {
            e.addEventListener("click", () => {
                wrapper.scrollIntoView();
            });
        });
    }

    document.addEventListener("DOMContentLoaded", initList);
</script>
