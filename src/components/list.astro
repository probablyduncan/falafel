---
import WrapMap from "./wrap-map.astro";
import { getDateEatenText } from "../lib/dateHelpers";
import getFalafel from "../lib/falafelLoader";
import { getOrdinal } from "../lib/textHelpers";
import { Content as Intro } from "../data/intro.mdx";
import Link from "./mdx/link.astro";

const falafel = getFalafel();

const morse = "..-. .- .-.. .- ..-. . .-.."
    .replaceAll("-", "—")
    .replaceAll(".", "-");
---

<main id="main">
    <div class="list">
        <div class="text">
            <section class="intro">
                <Intro
                    num={falafel.length}
                    about={new URL("about", Astro.site).toString()}
                    components={{ a: Link }}
                />
            </section>
            <ul>
                {
                    falafel.entryArr.map((entry, index) => {
                        const number = falafel.length - index;
                        const numberText = (falafel.length - index)
                            .toString()
                            .padStart(
                                1 + Math.floor(Math.log10(falafel.length)),
                                "0",
                            );
                        const ordinalText = getOrdinal(number);
                        const dateEatenText = getDateEatenText(entry);
                        return (
                            <li id={entry.cacheKey} data-entry={number}>
                                <div class="morse kyroh" role="presentation">
                                    {morse} {morse} {morse} {morse} {morse}
                                </div>
                                <div class="entry-header">
                                    <div class="stars" title="five stars!">
                                        <span
                                            role="img"
                                            aria-label="five stars"
                                        >
                                            ⭐⭐⭐⭐⭐
                                            {/* <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M128,189.09l54.72,33.65a8.4,8.4,0,0,0,12.52-9.17l-14.88-62.79,48.7-42A8.46,8.46,0,0,0,224.27,94L160.36,88.8,135.74,29.2a8.36,8.36,0,0,0-15.48,0L95.64,88.8,31.73,94a8.46,8.46,0,0,0-4.79,14.83l48.7,42L60.76,213.57a8.4,8.4,0,0,0,12.52,9.17Z" fill="var(--star-fill)" stroke="var(--star-stroke)" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--star-stroke-width)"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M128,189.09l54.72,33.65a8.4,8.4,0,0,0,12.52-9.17l-14.88-62.79,48.7-42A8.46,8.46,0,0,0,224.27,94L160.36,88.8,135.74,29.2a8.36,8.36,0,0,0-15.48,0L95.64,88.8,31.73,94a8.46,8.46,0,0,0-4.79,14.83l48.7,42L60.76,213.57a8.4,8.4,0,0,0,12.52,9.17Z" fill="var(--star-fill)" stroke="var(--star-stroke)" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--star-stroke-width)"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M128,189.09l54.72,33.65a8.4,8.4,0,0,0,12.52-9.17l-14.88-62.79,48.7-42A8.46,8.46,0,0,0,224.27,94L160.36,88.8,135.74,29.2a8.36,8.36,0,0,0-15.48,0L95.64,88.8,31.73,94a8.46,8.46,0,0,0-4.79,14.83l48.7,42L60.76,213.57a8.4,8.4,0,0,0,12.52,9.17Z" fill="var(--star-fill)" stroke="var(--star-stroke)" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--star-stroke-width)"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M128,189.09l54.72,33.65a8.4,8.4,0,0,0,12.52-9.17l-14.88-62.79,48.7-42A8.46,8.46,0,0,0,224.27,94L160.36,88.8,135.74,29.2a8.36,8.36,0,0,0-15.48,0L95.64,88.8,31.73,94a8.46,8.46,0,0,0-4.79,14.83l48.7,42L60.76,213.57a8.4,8.4,0,0,0,12.52,9.17Z" fill="var(--star-fill)" stroke="var(--star-stroke)" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--star-stroke-width)"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M128,189.09l54.72,33.65a8.4,8.4,0,0,0,12.52-9.17l-14.88-62.79,48.7-42A8.46,8.46,0,0,0,224.27,94L160.36,88.8,135.74,29.2a8.36,8.36,0,0,0-15.48,0L95.64,88.8,31.73,94a8.46,8.46,0,0,0-4.79,14.83l48.7,42L60.76,213.57a8.4,8.4,0,0,0,12.52,9.17Z" fill="var(--star-fill)" stroke="var(--star-stroke)" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--star-stroke-width)"/></svg> */}
                                        </span>
                                    </div>
                                    <h3 class="title">
                                        <>
                                            <span class="number">
                                                {number}.{" "}
                                            </span>
                                            <span
                                                class="name"
                                                title="show it on the map!"
                                                data-focus-falafel
                                                role="button"
                                                tabindex="0"
                                            >
                                                {entry.name}
                                            </span>
                                        </>
                                    </h3>
                                    <div class="subtitle">
                                        First eaten:{" "}
                                        <time>{dateEatenText}</time>
                                    </div>
                                </div>
                                <div class="entry-body">
                                    {entry.review
                                        .split("\n")
                                        .filter(Boolean)
                                        .map((p) => (
                                            <p>{p}</p>
                                        ))}
                                </div>
                                <div class="entry-footer">
                                    <a
                                        class="address"
                                        href={entry.googleMapsUri}
                                        target="_blank"
                                        rel="noopener"
                                        title="see it in Google Maps!"
                                    >
                                        {entry.address}
                                    </a>
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
    <div class="panel">
        <div class="grab-bar"></div>
        <WrapMap class="map" />
    </div>
    <footer></footer>
</main>

<style>
    #main {
        display: flex;
        flex-direction: column;
        min-height: 100lvh;
        border-top: 2px solid var(--color-map);
        scroll-margin-top: 1.5rem;
        overflow-x: clip;

        /** initial resting position - 0 is no map, 1 is full map */
        --map-open: 0;

        --map-min: 15;
        --map-max: 85;
        --map-height: calc(
            (
                    var(--map-min) + (var(--map-max) - var(--map-min)) *
                        var(--map-open)
                ) *
                1lvh
        );
    }

    .list {
        min-width: 0;
    }

    li {
        scroll-margin-top: var(--pad, 0);
    }

    .panel {
        position: sticky;
        bottom: 0;
        z-index: 4;
        margin-top: 60vw;
        height: var(--map-height);
    }

    .map {
        width: 100%;
        height: 100%;
    }

    .grab-bar {
        position: absolute;
        inset-inline: 0;
        bottom: calc(100% - 1rem);
        z-index: 1;
        height: 4rem;
        display: grid;
        place-items: center;
        cursor: grab;
        touch-action: none;
        user-select: none;
        background: linear-gradient(
            to top,
            var(--color-white) 50%,
            transparent 100%
        );
        border-radius: 0 0 1rem 1rem;
    }

    .grab-bar:active {
        cursor: grabbing;
    }

    .grab-bar::after {
        content: "";
        width: min(50%, 8rem);
        height: 0.5rem;
        border-radius: 0.5rem;
        background-color: var(--color-green);
    }

    .text {
        padding: 1rem;
    }

    .intro {
        h2 {
            font-size: 10vw;
            font-weight: bold;
            text-align: center;
            text-wrap: balance;
            margin-block: 2rem;
        }

        h2 + :global(p)::before {
            content: "";
            background-image: url("/falafel_stamp.png");
            background-size: contain;
            image-rendering: pixelated;
            filter: drop-shadow(0.05em 0.1em 0 #0004)
                drop-shadow(0 0.1em 2px #0004) drop-shadow(0.05em 0 2px #0004);
            display: inline-block;
            width: 0.8em;
            aspect-ratio: 1;
            margin-right: 3em;
            transform: translateY(0.05em);
        }

        h2 ~ :global(p):last-of-type::after {
            content: "w";
            font-family: var(--kyroh);
            font-feature-settings: "ss01";
            margin-left: 1em;
            text-shadow: 0.04em 0.08em 0 var(--color-yellow);
        }

        strong {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: var(--yellow-shadow);
        }

        em {
            font-weight: bold;
            font-style: normal;
        }

        a {
            text-decoration: underline;
            text-decoration-thickness: 2px;

            transition-duration: 0.34s;
            transition-timing-function: steps(4);
            transition: text-decoration;
        }

        a:hover,
        a:focus-visible {
            text-decoration: none;
            background-color: var(--color-black);
            color: var(--color-white);
            outline: 0.1em solid var(--color-black);
            outline-offset: 0;
            border-radius: 0.1em;
        }

        p:has(a:hover, a:focus-visible)::after {
            content: "→";
            font-family: var(--kyroh);
            font-size: 1.5em;
            display: inline-block;
            line-height: 0;
            width: 0;
            height: 0;
            transform: translate(0.14em, 0.27em) rotate(-30deg);
        }
    }

    ul {
        list-style: none;
        padding: unset;
    }

    .morse {
        white-space: pre;
        overflow-x: clip;
        margin-block: 2em 1em;
        font-size: 1.2em;
    }

    .entry-header {
        display: flex;
        flex-direction: column;
        gap: 0.2em;
    }

    .stars {
        font-size: 1.2em;
        line-height: 1;
        letter-spacing: 0.05em;
        margin-top: 0.4em;

        /* svg {
            --star-fill: alpha(from var(--color-yellow) / 0.25);
            --star-stroke: var(--color-yellow);
            --star-stroke-width: 20;
            width: 1em;
            filter: drop-shadow(var(--yellow-shadow)) sepia(0.2);
        } */
    }

    .title {
        font-size: 1.4em;
        line-height: 1.15;
        text-wrap: balance;
        overflow-wrap: anywhere;
        font-weight: bold;

        .number {
            color: alpha(from currentColor / 0.618);
            text-shadow: var(--yellow-shadow);
        }
        .name {
            text-shadow: var(--yellow-shadow);
            cursor: pointer;

            &:hover,
            &:focus-visible {
                text-decoration: underline;
                position: relative;
                color: alpha(from currentColor / 0.85);
                outline-offset: 0.125em;
                outline-width: 0.125em;
                outline-color: currentColor;

                &::after {
                    content: "";
                    background-image: url("/marker-icon.svg");
                    filter: drop-shadow(var(--yellow-shadow));
                    position: absolute;
                    aspect-ratio: 1;
                    width: 1.5ch;
                    right: -1.85ch;
                    bottom: -0.1ch;
                }
            }
        }
    }

    .subtitle {
        font-size: 0.85em;
        font-style: italic;
        font-weight: bold;

        color: alpha(from currentColor / 0.4);
        time {
            color: alpha(from currentColor / 0.5);
        }
    }

    .entry-body {
        font-size: 0.85rem;
        p {
            line-height: 1.618;
            margin-block: 1.618em;
        }

        p:first-of-type::before {
            content: "→";
            font-family: var(--kyroh);
            margin-right: 1.4em;
        }
    }

    .entry-footer {
        display: grid;
        grid-template-columns: auto 1fr;

        a.address {
            grid-column: 1;
            display: inline-block;
            overflow-wrap: anywhere;
            font-size: 0.7rem;
            font-weight: 500;
            line-height: 1.5;
            padding: 0.5em 1em;

            color: alpha(from currentColor / 0.8);
            background-color: alpha(from var(--color-yellow) / 0.1);
            border: 0.125em solid alpha(from var(--color-yellow) / 0.25);
            border-radius: 0.5em;

            &::before {
                margin-right: 0.4em;
                margin-left: -0.4em;
                display: inline-block;
                background-image: url("/trifold-icon.svg");
                content: "";
                aspect-ratio: 1;
                width: 1.2em;
                vertical-align: sub;
            }

            &::after {
                content: "→";
                font-family: var(--kyroh);
                display: inline-block;
                margin-left: 0.4em;
                translate: 0.1em 0em;
                rotate: -30deg;
                scale: 1.5;
            }

            &:hover,
            &:focus-visible {
                text-decoration: underline;
                text-decoration-thickness: 0.0875em;
                text-underline-offset: 0.125em;
                text-decoration-skip-ink: none;
                outline: none;
                border-color: currentColor;
                &::after {
                    content: "→";
                    translate: 0.15em -0.1em;
                    rotate: -45deg;
                    scale: 1.8;
                }
            }
        }
    }

    @media (min-aspect-ratio: 1) {
        #main {
            --pad: 1rem;
            --header-height: 1.9rem;

            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--pad);
            padding: var(--pad);
        }

        .list {
            grid-column: 2;
        }

        li {
            scroll-margin-top: 0;
        }

        .panel {
            grid-column: 1;
            grid-row: 1;
            top: calc(var(--header-height) + var(--pad));
            bottom: auto;
            height: calc(100lvh - var(--header-height) - 2 * var(--pad));
            margin-top: 0;
        }

        .map {
            border: 4px solid var(--color-black);
            border-radius: var(--pad);
        }

        .grab-bar {
            display: none;
        }

        .text {
            padding: 0;
        }

        .intro {
            h2 {
                font-size: 3.14vw;
                text-align: left;
            }
        }
    }

    @media (max-aspect-ratio: 1) {
        footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 10000;
            background-color: black;
            height: 8px;
        }
    }
</style>

<script>
    import { AnimationController } from "../lib/animationController";
    import { Lerp } from "../lib/lerp";
    import {
        addMapFalafelClickListener,
        focusMapFalafel,
    } from "../lib/mapEvents";

    /*
     * --map-open runs from 0 (map at its smallest, --map-min in the css) to
     * 1 (map at its largest, --map-max). Releasing the grab bar snaps to one
     * of these, so add, remove, or nudge values to taste. Keep them ascending.
     * 0 = sliver of map, 1 = almost all map, in between = both visible.
     */
    const REST_POSITIONS = [0, 0.5, 1];

    /** when jumping to an entry from the map, the map shrinks to at most this */
    const READING_POSITION = REST_POSITIONS[1];

    /** time to get halfway to the rest position after release */
    const SETTLE_HALF_LIFE_MS = 80;

    /** a release is thrown this far ahead (velocity * time) before picking the nearest rest position */
    const FLING_PROJECTION_MS = 200;

    /** past 0 or 1 the map follows the finger at this fraction, up to MAX_OVERSHOOT */
    const OVERSHOOT_RESISTANCE = 0.25;
    const MAX_OVERSHOOT = 0.1;

    /** pointer movement under this (px) on release counts as a tap, not a drag */
    const TAP_SLOP_PX = 6;

    function resist(open: number) {
        const resisted =
            open < 0
                ? open * OVERSHOOT_RESISTANCE
                : open > 1
                  ? 1 + (open - 1) * OVERSHOOT_RESISTANCE
                  : open;
        return Math.min(1 + MAX_OVERSHOOT, Math.max(-MAX_OVERSHOOT, resisted));
    }

    function nearestRest(open: number) {
        return REST_POSITIONS.reduce((best, p) =>
            Math.abs(p - open) < Math.abs(best - open) ? p : best,
        );
    }

    function nextRest(open: number) {
        const i = REST_POSITIONS.indexOf(nearestRest(open));
        return REST_POSITIONS[(i + 1) % REST_POSITIONS.length];
    }

    function initList() {
        const wrapper = document.querySelector("#main") as HTMLElement;
        const panel = document.querySelector(".panel") as HTMLElement;
        const grabBar = document.querySelector(".grab-bar") as HTMLElement;

        const isMobileLayout = () =>
            !window.matchMedia("(min-aspect-ratio: 1)").matches;

        const css = getComputedStyle(wrapper);
        const cssNumber = (name: string) =>
            parseFloat(css.getPropertyValue(name));

        // start wherever the css says, so there's no jump on load
        const mapOpen = new Lerp(SETTLE_HALF_LIFE_MS);
        mapOpen.reset(cssNumber("--map-open"));

        function render() {
            wrapper.style.setProperty("--map-open", mapOpen.current.toFixed(4));
        }

        const animationController = new AnimationController(({ delta }) => {
            mapOpen.step(delta);

            // Lerp.isAtRest() uses a fixed 0.1 tolerance, which is far too
            // coarse for a 0-1 range, so check here instead
            if (Math.abs(mapOpen.target - mapOpen.current) < 0.001) {
                mapOpen.fastForward();
            }

            render();
            return mapOpen.current !== mapOpen.target;
        });

        function settleAt(target: number, instant: boolean = false) {
            mapOpen.target = target;
            if (instant) {
                mapOpen.current = mapOpen.target;
            }
            animationController.playIfPaused();
        }

        grabBar.addEventListener("pointerdown", (down) => {
            if (down.button !== 0) return;

            // pointer capture keeps move/up events coming even when the
            // pointer leaves the grab bar or the window
            grabBar.setPointerCapture(down.pointerId);

            // grabbing the map mid-animation freezes it
            mapOpen.target = mapOpen.current;

            // lvh isn't a fixed number of px (mobile toolbars), so work out how
            // many px of dragging equal 1.0 of --map-open from the rendered height
            const min = cssNumber("--map-min");
            const range = cssNumber("--map-max") - min;
            const lvhPx =
                panel.getBoundingClientRect().height /
                (min + range * mapOpen.current);
            const pxPerUnit = range * lvhPx;

            const startY = down.clientY;
            const startOpen = mapOpen.current;
            let lastY = startY;
            let lastT = down.timeStamp;
            let velocity = 0; // --map-open units per ms
            let moved = false;

            const abort = new AbortController();
            const { signal } = abort;

            grabBar.addEventListener(
                "pointermove",
                (move) => {
                    if (Math.abs(move.clientY - startY) > TAP_SLOP_PX) {
                        moved = true;
                    }

                    const dt = move.timeStamp - lastT;
                    if (dt > 0) {
                        const v = (lastY - move.clientY) / pxPerUnit / dt;
                        velocity = 0.5 * velocity + 0.5 * v;
                        lastY = move.clientY;
                        lastT = move.timeStamp;
                    }

                    // dragging up (smaller clientY) opens the map
                    mapOpen.target = resist(
                        startOpen + (startY - move.clientY) / pxPerUnit,
                    );
                    mapOpen.fastForward(); // follow the pointer exactly
                    render();
                },
                { signal },
            );

            function end(up: PointerEvent) {
                abort.abort();

                if (!moved && up.type === "pointerup") {
                    settleAt(nextRest(mapOpen.current));
                    return;
                }

                // a pointer that stopped before release has no momentum
                const idle = up.timeStamp - lastT > 100;
                const projected =
                    mapOpen.current +
                    (idle ? 0 : velocity) * FLING_PROJECTION_MS;
                settleAt(nearestRest(projected));
            }

            grabBar.addEventListener("pointerup", end, { signal });
            grabBar.addEventListener("pointercancel", end, { signal });
        });

        // focus map on falafel when an entry's map button is clicked
        document.querySelectorAll("[data-entry]").forEach((li) => {
            li.querySelectorAll("[data-focus-falafel]").forEach((button) =>
                button.addEventListener("click", () => {
                    focusMapFalafel(li.id);
                }),
            );
        });

        // scroll to entry when map falafel is clicked
        addMapFalafelClickListener((id: string) => {
            const el = document.getElementById(id);
            if (!el) return;

            el.scrollIntoView({ behavior: "instant" });

            // shrink the map (never grow it) so the entry can be read
            settleAt(Math.min(mapOpen.target, READING_POSITION), true);
        });
    }

    document.addEventListener("DOMContentLoaded", initList);
</script>
