---
import "maplibre-gl/dist/maplibre-gl.css";
import Favicons from "../components/favicons.astro";
import WrapMap from "../components/wrap-map.astro";
import { countWords, truncateText } from "../lib/textHelpers";
import { getDateEatenText } from "../lib/dateHelpers";
import getFalafel from "../lib/falafelLoader";
import "../styles/global.css";

const falafel = getFalafel();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Favicons />
        <link rel="manifest" href="/site.webmanifest" />
        <title>Wrap Map (falafel.fyi)</title>
    </head>
    <body>
        <main>
            <WrapMap class="map" />
            <div>
                <ul>
                    {
                        falafel.entryArr.map((entry) => {
                            const truncatedReview = truncateText(
                                entry.review,
                                55,
                            );
                            const location = entry.address?.split(" ").at(-1);

                            return (
                                <li id={entry.cacheKey}>
                                    <div class="header">
                                        <div>
                                            <h2>
                                                <b>{entry.name}</b>
                                            </h2>
                                            {entry.address && (
                                                <i>
                                                    <a
                                                        href={
                                                            entry.googleMapsUri
                                                        }
                                                        title="View in Google Maps"
                                                        target="_blank"
                                                    >
                                                        {/* {truncateText(
                                                        entry.address,
                                                        50,
                                                    )} */}
                                                        {location} ↝
                                                    </a>
                                                </i>
                                            )}
                                        </div>
                                        <i class="date">
                                            <span>first eaten</span>
                                            <br />
                                            <b>
                                                {getDateEatenText(
                                                    entry,
                                                ).toLowerCase()}
                                            </b>
                                        </i>
                                    </div>
                                    <div>
                                        <button
                                            data-falafel-id={entry.cacheKey}
                                        >
                                            map
                                        </button>
                                    </div>
                                    {entry.review
                                        .split("\n")
                                        .filter(Boolean)
                                        .map((p) => (
                                            <p>{p}</p>
                                        ))}
                                </li>
                            );
                        })
                    }
                </ul>
            </div>
        </main>
    </body>
</html>

<style>
    main {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .map {
        width: 100%;
        height: 100vh;
        position: sticky;
        top: 0;
    }

    ul {
        max-width: 100%;
        margin-inline: 5%;
        list-style: none;
        padding: unset;
    }

    li {
        max-width: 100%;
        margin-top: 50px;
    }

    .header {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 2px dotted black;
    }

    .date {
        text-align: right;
    }

    h2 {
        margin: unset;
    }
</style>

<script>
    import { addMapFalafelClickListener, focusMapFalafel } from "../lib/map";

    function initFalafelButtons() {
        document.querySelectorAll("button[data-falafel-id]").forEach((_b) => {
            _b.addEventListener("click", () =>
                focusMapFalafel(
                    (_b as HTMLButtonElement).dataset["falafelId"] as string,
                ),
            );
        });

        addMapFalafelClickListener((id) => {
            window.location.href = "#" + id;
        });
    }

    document.addEventListener("DOMContentLoaded", initFalafelButtons);
</script>
