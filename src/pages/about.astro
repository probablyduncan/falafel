---
import Head from "../components/head.astro";
import getFalafel from "../lib/falafelLoader";
import { Content, getHeadings } from "../data/about.mdx";
import Link from "../components/mdx/link.astro";

const falafel = getFalafel();
const headings = getHeadings();
---

<!doctype html>
<html lang="en">
    <Head title="About Duncan’s Wrap Map" />
    <body>
        <header>
            <nav id="navbar">
                <a id="home" href="/" title="back! to the home page"
                    >{Astro.site?.toString().replace(/\/$/, "")}</a
                >
                <h1 id="page">
                    <a href="/about" title="you are here!">about</a>
                </h1>
                <button id="heading-button" title="table of contents">{headings[0].slug}</button>
            </nav>
            <img id="scrollafel" src="/falafel_stamp.png" draggable="false" />
            <img id="wrap-bg" src="/wrap_menu_bg.webp" draggable="false" />
            <img id="wrap-fg" src="/wrap_menu_fg.webp" draggable="false" />
        </header>
        <main class="text-container">
            <article>
                <Content
                    components={{ a: Link }}
                    num={falafel.length}
                    site={Astro.site}
                    googleMapsUri={falafel.googleMapsUri}
                />
            </article>
        </main>
    </body>
</html>

<style>
    body {
        font-size: 0.85rem;
    }

    main,
    header {
        display: grid;
        grid-template-columns: 1fr minmax(auto, 50ch) 1.618fr;
    }

    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background-color: var(--color-white);
        padding-top: 0.4em;
        padding-bottom: 0.3em;
        border-bottom: 0.21em solid var(--color-yellow);

        nav {
            display: flex;
        }

        a:hover,
        a:focus-visible {
            text-decoration: underline;
            text-decoration-thickness: 0.0875em;
            text-underline-offset: 0.125em;
            text-decoration-skip-ink: none;
            outline: none;
            background-color: var(--color-yellow);
        }

        #home {
            font-weight: bold;
        }

        #page {
            display: inline;
            font-weight: bold;
            margin-inline: 0.5ch;
        }

        #page::before {
            content: "/";
            margin-right: 0.5ch;
        }
        #page::after {
            content: "#";
            margin-left: 0.5ch;
            font-weight: normal;
        }

        #heading-button {
            appearance: unset;
            border: unset;
            background-color: unset;
            border-radius: unset;
            font-size: unset;
            font-family: unset;
            padding: unset;
            color: unset;

            cursor: pointer;
            font-style: italic;
            min-width: 4ch;
            text-align: left;

            &:hover,
            &:focus-visible {
                background-color: var(--color-yellow);
                text-decoration: underline;
                text-decoration-thickness: 0.0875em;
                text-underline-offset: 0.125em;
                text-decoration-skip-ink: none;
                outline: none;
            }
        }

        img {
            position: fixed;
            image-rendering: pixelated;
            pointer-events: none;
            user-select: none;
        }

        img#wrap-bg {
            z-index: 103;
        }

        img#scrollafel {
            --width: 1.4em;
            width: var(--width);
            top: 0.15em;
            z-index: 104;

            --left: 0.2em;
            --left: -0.6em;
            --right: 3.5em;

            --progress: 0;

            left: calc(
                var(--left) + var(--progress) *
                    calc(100vw - var(--right) - var(--left))
            );
            rotate: calc(var(--progress) * (100vw / var(--width)) * 120deg);
        }

        img#wrap-fg {
            z-index: 105;
        }

        img#wrap-bg,
        img#wrap-fg {
            top: 0.1em;
            right: 0.3em;
            height: 1.6em;
        }
    }

    article,
    nav {
        grid-column: 2;
        margin-inline: 1rem;
    }

    article {
        margin-bottom: 50svh;
    }

    article {
        margin-top: 50svh;
        position: relative;
        counter-reset: footnote-ref footnote section -1;

        /* visually hidden, still there for SEO and screen readers */
        h2 {
            counter-increment: section;
            position: absolute;
            width: 1px;
            height: 1px;
            margin: 0;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        :global(h2:not(:first-of-type) + p) {
            margin-top: 20svh;
        }

        :global(.section-marker) {
            margin-right: 8ch;

            &::before {
                content: "[" counter(section) "]";
                font-weight: bolder;
                text-shadow: var(--yellow-shadow);
                display: inline-block;
                translate: -0.1em -0.1em;
                rotate: -2deg;
            }
        }

        p {
            line-height: 1.618;
            margin-block: 1.618em;
        }

        strong {
            font-weight: bold;
            font-style: normal;
        }

        :global(em > strong, strong > em) {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: var(--yellow-shadow);
        }

        :global(a) {
            text-decoration: underline;
            text-decoration-thickness: 0.0875em;
            text-underline-offset: 0.125em;
            text-decoration-skip-ink: none;
            &:hover,
            &:focus-visible {
                outline: none;
                background-color: var(--color-yellow);
            }

            &:active {
                background-color: unset;
            }
        }

        :global(blockquote) {
            border-inline-start: 0.25em solid var(--color-yellow);
            margin-inline: 1em;
            margin-block-end: 2.5em;
            padding-inline: 2em;
            font-style: italic;
            font-size: 0.8em;
            opacity: 0.8;
        }

        :global(sup) {
            line-height: 0.5;
            font-weight: 500;

            :global(a:hover, a:focus-visible) {
                background-color: var(--color-yellow);
                outline: none;
                text-decoration: underline;
            }
        }

        :global(.footnote-ref) {
            counter-increment: footnote-ref;
            &::before {
                font-family: "Kyroh";
                text-shadow: var(--yellow-shadow);
                font-size: 0.8em;
                content: counter(footnote-ref);
            }
        }

        /* Each note is its own <aside>; a run of adjacent notes reads as one box. */
        :global(.footnote) {
            counter-increment: footnote;
            display: flex;
            gap: 0.8ch;
            font-size: 0.75em;

            margin-inline: 1em;
            padding-inline: 1em;
            padding-top: 0.5em;

            background-color: alpha(from var(--color-yellow) / 0.1);
            --border: 0.125em solid alpha(from var(--color-yellow) / 0.25);
            --border-radius: 0.5em;
            border-inline: var(--border);

            /** first footnote in block */
            &:global(.footnote:not(.footnote + .footnote)) {
                border-top-left-radius: 0.5em;
                border-top-right-radius: 0.5em;
                border-top: var(--border);
                margin-top: 0.5em;
            }

            /** final footnote in block */
            &:global(.footnote:not(:has(+ .footnote))) {
                border-bottom-left-radius: 0.5em;
                border-bottom-right-radius: 0.5em;
                border-bottom: var(--border);
                margin-bottom: 1em;
                padding-bottom: 0.5em;
            }

            /** footnote number */
            &::before {
                font-family: "Kyroh";
                text-shadow: var(--yellow-shadow);
                content: counter(footnote);
            }

            /** footnote text */
            :global(p) {
                text-indent: 0;
                margin: 0;
            }
        }
    }
</style>

<script>
    import { AnimationController } from "../lib/animationController";
    import { Lerp } from "../lib/lerp";

    function initScrollTracker() {
        const falafel = document.getElementById("scrollafel");
        if (!falafel) return;

        const scrollerp = new Lerp();
        const animation = new AnimationController(({ delta }) => {
            scrollerp.step(delta);
            updateUI();
            return Math.abs(scrollerp.target - scrollerp.current) > 0.001;
        });

        function updateTarget() {
            scrollerp.target =
                window.scrollY /
                (document.body.scrollHeight - window.innerHeight);
            animation.playIfPaused();
        }

        function updateUI() {
            falafel!.style.setProperty(
                "--progress",
                scrollerp.current.toString(),
            );
        }

        updateTarget();
        scrollerp.current = scrollerp.target;
        updateUI();

        window.addEventListener("scroll", updateTarget);
    }

    document.addEventListener("DOMContentLoaded", initScrollTracker);

    function initHeadings() {
        const headings =
            document.querySelectorAll<HTMLHeadingElement>("article h2");
        const headingDisplay = document.getElementById("heading-button")!;

        if (headings.length < 2 || !headingDisplay) {
            return;
        }

        function onScroll() {
            const threshold = window.scrollY - window.innerHeight / 5;
            let sectionIndex = 0;
            for (let i = 1; i < headings.length; i++) {
                if (headings[i].offsetTop > threshold) {
                    break;
                }
                sectionIndex = i;
            }

            // if (sectionIndex === 0) {
            //     headingDisplay.innerText = "";
            // } else {
            headingDisplay.innerText = headings[sectionIndex].id;
            // }
        }

        onScroll();
        window.addEventListener("scroll", onScroll);
    }

    document.addEventListener("DOMContentLoaded", initHeadings);
</script>
