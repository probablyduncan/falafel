---
import Head from "../components/head.astro";
import getFalafel from "../lib/falafelLoader";
import { Content, getHeadings } from "../data/about.mdx";
import Link from "../components/mdx/link.astro";

const falafel = getFalafel();

const writeDateString = "12 Oct 2026";
---

<!doctype html>
<html lang="en">
    <Head title="About Duncan’s Wrap Map" />
    <body>
        <main class="text-container">
            <header>
                <nav>
                    <span>
                        <a href="/" title="back! to the home page"
                            >https://falafel.fyi</a
                        >
                        &nbsp;/&nbsp;
                        <h1>
                            <a
                                href={"/about"}
                                title={"about falafel.fyi (you're already here!)"}
                                >about</a
                            >
                        </h1>
                    </span>
                    <span title={writeDateString}
                        >{writeDateString.replaceAll("0", "o")}</span
                    >
                </nav>
            </header>
            <article>
                <Content
                    components={{ a: Link }}
                    num={falafel.length}
                    site={Astro.site}
                    googleMapsUri={falafel.googleMapsUri}
                />
            </article>
        </main>
    </body>
</html>

<style>
    body {
        display: grid;
        grid-template-columns: 1fr auto 1.618fr;
    }

    main {
        max-width: 50ch; /** 61.8ch? */
        grid-column: 2;
        margin-inline: 1rem;
        box-sizing: border-box;
        font-size: 0.85rem;
        margin-bottom: 50svh;
    }

    :global(a) {
        text-decoration: underline;
        text-decoration-thickness: 0.0875em;
        text-underline-offset: 0.125em;
        text-decoration-skip-ink: none;
        &:hover,
        &:focus-visible {
            outline: none;
            background-color: var(--color-yellow);
        }

        &:active {
            background-color: unset;
        }
    }

    header {
        min-height: 50svh;

        nav {
            position: sticky;
            top: 0;
            padding-top: 1rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;

            @media screen and (max-width: 58ch) {
                flex-direction: column;
            }

            h1 {
                display: inline;
            }
        }
    }

    article {
        position: relative;
        counter-reset: footnote-ref footnote section -1;

        /* visually hidden, still there for SEO and screen readers */
        h2 {
            counter-increment: section;
            position: absolute;
            width: 1px;
            height: 1px;
            margin: 0;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        :global(h2:not(:first-of-type) + p) {
            margin-top: 20svh;
        }

        :global(.section-marker) {
            margin-right: 8ch;
            
            &::before {
                content: "[" counter(section) "]";
                font-weight: bolder;
                text-shadow: var(--yellow-shadow);
                display: inline-block;
                translate: -0.1em -0.1em;
                rotate: -2deg;
            }
        }

        p {
            line-height: 1.618;
            text-wrap: pretty;
            margin-block: 1.618em;
        }

        strong {
            font-weight: bold;
            font-style: normal;
        }

        :global(em > strong, strong > em) {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: var(--yellow-shadow);
        }

        :global(sup) {
            line-height: 0.5;
            font-weight: 500;

            :global(a:hover, a:focus-visible) {
                background-color: var(--color-yellow);
                outline: none;
                text-decoration: underline;
            }
        }

        :global(.footnote-ref) {
            counter-increment: footnote-ref;
            &::before {
                font-family: "Kyroh";
                text-shadow: var(--yellow-shadow);
                font-size: 0.8em;
                content: counter(footnote-ref);
            }
        }

        /* Each note is its own <aside>; a run of adjacent notes reads as one box. */
        :global(.footnote) {
            counter-increment: footnote;
            display: flex;
            gap: 0.8ch;
            text-wrap: pretty;
            font-size: 0.75em;
            
            margin-inline: 1em;
            padding-inline: 1em;
            padding-top: 0.5em;

            background-color: alpha(from var(--color-yellow) / 0.1);
            --border: 0.125em solid alpha(from var(--color-yellow) / 0.25);
            --border-radius: 0.5em;
            border-inline: var(--border);

            /** first footnote in block */
            &:global(.footnote:not(.footnote + .footnote)) {
                border-top-left-radius: 0.5em;
                border-top-right-radius: 0.5em;
                border-top: var(--border);
                margin-top: 0.5em;
            }

            /** final footnote in block */
            &:global(.footnote:not(:has(+ .footnote))) {
                border-bottom-left-radius: 0.5em;
                border-bottom-right-radius: 0.5em;
                border-bottom: var(--border);
                margin-bottom: 1em;
                padding-bottom: 0.5em;
            }

            /** footnote number */
            &::before {
                font-family: "Kyroh";
                text-shadow: var(--yellow-shadow);
                content: counter(footnote);
            }

            /** footnote text */
            :global(p) {
                text-indent: 0;
                margin: 0;
            }
        }
    }
</style>
