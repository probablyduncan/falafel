---
import Head from "../components/head.astro";
import WrapMap from "../components/wrap-map.astro";
import { getDateEatenText } from "../lib/dateHelpers";
import getFalafel from "../lib/falafelLoader";

const falafel = getFalafel();

//             ..-. .- .-.. .- ..-. . .-..
const morse = "ssls sl slss sl ssls s slss"
    .replaceAll(" ", " ")
    .replaceAll("s", "-")
    .replaceAll("l", "—");
---

<!doctype html>
<html lang="en">
    <Head />
    <body>
        <!-- <TopBar /> -->
        <main>
            <WrapMap class="map" />
            <div class="falafel">
                <h2>
                    Here are All the Places that I (<a
                        href="https://duncanpetrie.com"
                        target="_blank"
                        title="https://duncanpetrie.com">Duncan</a
                    >) have <em>Eaten Falafel</em>
                </h2>
                <ul>
                    {
                        falafel.entryArr
                            .slice(0, falafel.length)
                            .map((entry, index) => {
                                const number = (falafel.length - index)
                                    .toString()
                                    .padStart(
                                        1 +
                                            Math.floor(
                                                Math.log10(falafel.length),
                                            ),
                                        "0",
                                    );
                                const dateEatenText = getDateEatenText(entry);
                                return (
                                    <li>
                                        <div class="morse kyroh" role="presentation">
                                            {morse} {morse} {morse} {morse} {morse}
                                        </div>
                                        <div class="entry-header">
                                            <div class="number">[{number}]</div>
                                            <div class="row">
                                                <h3 class="name">
                                                    {entry.name}
                                                </h3>
                                            </div>
                                            <div class="row">
                                                <div class="address" title={entry.address}>
                                                    {entry.address
                                                        ?.split(" ")
                                                        .at(-1)}
                                                </div>
                                                <div class="stars" title="five stars!">
                                                    ⭐⭐⭐⭐⭐
                                                </div>
                                            </div>
                                        </div>
                                        <div class="entry-body">
                                            {entry.review
                                                .split("\n")
                                                .filter(Boolean)
                                                .map((p) => (
                                                    <p>{p}</p>
                                                ))}
                                            <p class="date">
                                                <>
                                                    <span>First eaten: </span>
                                                    <em>{dateEatenText}</em>.
                                                </>
                                            </p>
                                        </div>
                                    </li>
                                );
                            })
                    }
                </ul>
            </div>
        </main>
    </body>
</html>

<style>
    main {
        display: grid;
        grid-template-columns: 1fr 1fr;

        --gap: 1rem;
        gap: var(--gap);
        padding: var(--gap);

        min-height: 100lvh;
    }

    .map {
        height: calc(100lvh - 2 * var(--gap));
        border: 4px solid var(--color-black);
        background-color: var(--color-black);
        border-radius: calc(var(--gap) / 2);
        position: sticky;
        top: var(--gap);
    }

    .falafel {
        min-width: 0;
    }

    h2 {
        font-size: 3vw;
        font-weight: bold;
        text-wrap: balance;
        text-wrap: pretty;

        a:hover {
            text-decoration: underline;
            text-decoration-thickness: 0.1em;

            /* &:hover {
                text-decoration: unset;
            } */
        }
    }

    ul {
        list-style: none;
        padding: unset;
    }

    .morse {
        white-space: pre;
        overflow-x: clip;
        text-overflow: clip;
        margin-top: 2em;
        margin-bottom: 1em;
    }

    .entry-header {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(2, auto);
        align-items: end;
        line-height: 1;
    }

    .entry-header > div {
        display: flex;
        justify-content: space-between;
        align-items: end;
    }

    .number {
        font-size: 2.4em;
        font-weight: bold;
        margin-right: 0.1em;
        font-feature-settings: "tnum";
        grid-row-start: 1;
        grid-row-end: 3;
    }

    .name {
        font-weight: bold;
        text-wrap: balance;
        text-wrap: balance;
    }

    .address {
        font-style: italic;
    }

    .stars,
    .date {
        text-align: right;
    }

    .date {
        opacity: 0.65;
        span {
            font-style: italic;
        }
        em {
            font-weight: bold;
        }
    }
</style>
