---
import getFalafel from "../lib/falafelLoader";
import { getDateEatenText } from "../lib/dateHelpers";
import Hero from "../components/hero.astro";
import TopBar from "../components/top-bar.astro";
import Head from "../components/head.astro";
import WrapMap from "../components/wrap-map.astro";

const falafel = getFalafel();

//             ..-. .- .-.. .- ..-. . .-..
const morse = "ssls sl slss sl ssls s slss"
    .replaceAll(" ", " ")
    .replaceAll("s", "-")
    .replaceAll("l", "—");

const aboutHref = new URL("about", Astro.site).toString();
---

<!doctype html>
<html lang="en">
    <Head />
    <body>
        <TopBar />
        <Hero />
        <main>
            <WrapMap class="map" />
            <div id="falafel">
                <h2>
                    These are all the places that I have <strong
                        >“Eaten Falafel”</strong
                    >
                </h2>
                <p>
                    Welcome to <strong>falafel.fyi</strong>, a weird little
                    microblog about my favorite kind of ball. Every time I order
                    a <em>falafel wrap</em> from a new cart, cafe, or restaurant,
                    I write a little review, and put it here.
                </p>
                <p>
                    For <em>more information</em> about my love of falafel wraps,
                    why they’re all rated five stars, and how I built this website,
                    navigate your <em>internet browser</em> to <a
                        href="/about"
                        title={aboutHref}>{aboutHref}</a
                    >.
                </p>
                <p>
                    If you prefer Google Maps, these reviews are also available
                    as <span class="nowrap"
                        >a <a
                            href={falafel.googleMapsUri}
                            title={`view the Wraps / in Google Maps`}
                            target="_blank">saved list</a
                        >.</span
                    >
                </p>
                <p>Enjoy your stay!</p>
                <ul>
                    {
                        falafel.entryArr
                            .slice(0, falafel.length)
                            .map((entry, index) => {
                                const number = (falafel.length - index)
                                    .toString()
                                    .padStart(
                                        1 +
                                            Math.floor(
                                                Math.log10(falafel.length),
                                            ),
                                        "0",
                                    );
                                const dateEatenText = getDateEatenText(entry);
                                return (
                                    <li id={entry.cacheKey}>
                                        <div
                                            class="morse kyroh"
                                            role="presentation"
                                        >
                                            {morse} {morse} {morse} {morse}{" "}
                                            {morse}
                                        </div>
                                        <div class="entry-header">
                                            <div class="number">[{number}]</div>
                                            <div class="row">
                                                <h3 class="name">
                                                    {entry.name}
                                                </h3>
                                            </div>
                                            <div class="row">
                                                <div
                                                    class="address"
                                                    title={entry.address}
                                                >
                                                    {entry.address
                                                        ?.split(" ")
                                                        .at(-1)}
                                                </div>
                                                <div
                                                    class="stars"
                                                    title="five stars!"
                                                >
                                                    ⭐⭐⭐⭐⭐
                                                </div>
                                            </div>
                                        </div>
                                        <div class="entry-body">
                                            {entry.review
                                                .split("\n")
                                                .filter(Boolean)
                                                .map((p) => (
                                                    <p>{p}</p>
                                                ))}
                                            <p class="date">
                                                <>
                                                    <span>First eaten: </span>
                                                    <em>{dateEatenText}</em>.
                                                </>
                                            </p>
                                        </div>
                                    </li>
                                );
                            })
                    }
                </ul>
            </div>
        </main>
    </body>
</html>

<style>
    main {
        display: grid;
        grid-template-columns: 1fr 1fr;

        --gap: 1rem;
        gap: var(--gap);
        padding: var(--gap);

        min-height: 100lvh;
    }

    .map {
        height: calc(100lvh - 2 * var(--gap));
        border: 4px solid var(--color-black);
        background-color: var(--color-black);
        background-color: #3B4A33;
        border-radius: calc(var(--gap) / 2);
        position: sticky;
        top: var(--gap);
    }

    #falafel {
        min-width: 0;
        padding-block: 1rem;
    }

    h2 {
        font-size: 3.14vw;
        font-weight: bold;
        text-wrap: balance;
    }

    h2,
    h2 ~ p {
        strong {
            font-family: var(--kyroh);
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            text-shadow: 0.04em 0.08em 0 var(--color-yellow);
        }

        em {
            font-weight: bold;
            font-style: normal;
            text-shadow: 0.04em 0.08em 0 var(--color-yellow);
        }

        a {
            text-decoration: underline;
            text-decoration-thickness: 2px;
            /* text-decoration-style: wavy;
            text-decoration-skip-ink: none; */
        }

        a:hover {
            /* text-shadow: 0.04em 0.08em 0 var(--color-yellow); */
            text-decoration: none;
        }

        .nowrap {
            white-space: pre;
        }
    }

    h2 + p::before {
        content: "";
        background-image: url("/falafel_stamp.png");
        background-size: contain;
        image-rendering: pixelated;
        filter: drop-shadow(1px 2px 3px #0004) blur(0.5px);
        display: inline-block;
        width: 0.8em;
        aspect-ratio: 1;
        margin-right: 3em;
        transform: translateY(0.1em);
    }

    h2 ~ p:last-of-type::after {
        content: "w";
        text-align: right;
        /* float: right; */
        font-family: var(--kyroh);
        font-feature-settings: "ss01";
        margin-left: 1em;
        text-shadow: 0.04em 0.08em 0 var(--color-yellow);
    }

    ul {
        list-style: none;
        padding: unset;
    }

    .morse {
        white-space: pre;
        overflow-x: clip;
        text-overflow: clip;
        margin-top: 2em;
        margin-bottom: 1em;
        font-size: 1.2em;
    }

    .entry-header {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(2, auto);
        align-items: end;
        line-height: 1;
    }

    .entry-header > div {
        display: flex;
        justify-content: space-between;
        align-items: end;
    }

    .number {
        font-size: 2.4em;
        font-weight: bold;
        margin-right: 0.1em;
        font-feature-settings: "tnum";
        grid-row-start: 1;
        grid-row-end: 3;
    }

    .name {
        font-weight: bold;
        text-wrap: balance;
        text-wrap: balance;
    }

    .address {
        font-style: italic;
    }

    .stars,
    .date {
        text-align: right;
    }

    .date {
        opacity: 0.65;
        span {
            font-style: italic;
        }
        em {
            font-weight: bold;
        }
    }
</style>

<script>
    import {
        addMapFalafelClickListener,
        addMapFalafelFocusListener,
        focusMapFalafel,
    } from "../lib/mapEvents";

    let shouldRefocusOnScroll = true;
    let currentScrollFocusId = "";

    function initBlogRoll() {
        addMapFalafelClickListener((id: string) => {
            if (window.location.hash?.replace(/^#/, "") == id) {
                window.location.hash = "falafel";
                shouldRefocusOnScroll = true;
            } else {
                window.location.hash = id;
                shouldRefocusOnScroll = false;
            }
        });

        document.querySelectorAll("#falafel li").forEach((_e) => {
            _e.addEventListener("click", () => {
                if (window.location.hash?.replace(/^#/, "") == _e.id) {
                    return;
                }
                focusMapFalafel(_e.id);
                window.location.hash = _e.id;
            });
        });
    }

    document.addEventListener("DOMContentLoaded", initBlogRoll);

    document.addEventListener("scroll", () => {
        if (!shouldRefocusOnScroll) {
            return;
        }

        const allEntries = document.querySelectorAll("#falafel li");
        const target = {
            el: allEntries[0],
            pixelsOnScreen: getPixelsOnScreen(allEntries[0]),
        };

        function getPixelsOnScreen(el: Element) {
            if (!el.checkVisibility()) {
                return 0;
            }

            const rect = el.getBoundingClientRect();
            if (rect.bottom < 0 || rect.top > window.innerHeight) {
                return 0;
            }

            return (
                Math.min(rect.bottom, window.innerHeight) -
                Math.max(rect.top, 0)
            );
        }

        for (let i = 1; i < allEntries.length; i++) {
            const el = allEntries[i];
            const pixelsOnScreen = getPixelsOnScreen(el);
            if (pixelsOnScreen > target.pixelsOnScreen) {
                target.pixelsOnScreen = pixelsOnScreen;
                target.el = el;
            }
        }

        if (currentScrollFocusId != target.el.id) {
            currentScrollFocusId = target.el.id;
            focusMapFalafel(currentScrollFocusId);
        }

    });
</script>
