---
import getFalafel from "../lib/falafelLoader";
import { getDateEatenText, toShortDateString } from "../lib/dateHelpers";
import { truncateText, countWords } from "../lib/textHelpers";
import "../styles/global.css";
import Hero from "../components/hero.astro";

const falafel = getFalafel();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
    </head>
    <body>
        <Hero />
        <main>
            <ul>
                {
                    falafel.entryArr.map((entry) => {
                        const truncatedReview = truncateText(entry.review, 55);

                        return (
                            <li>
                                <div class="header">
                                    <div>
                                        <h2>{entry.name}</h2>
                                        {entry.address && (
                                            <i>
                                                <a
                                                    href={entry.googleMapsUri}
                                                    title={entry.googleMapsUri}
                                                    target="_blank"
                                                >
                                                    {truncateText(
                                                        entry.address,
                                                        50,
                                                    )}
                                                </a>
                                            </i>
                                        )}
                                    </div>
                                    <i class="date">
                                        <span>first eaten</span>
                                        <br />
                                        <b>
                                            {getDateEatenText(
                                                entry,
                                            ).toLowerCase()}
                                        </b>
                                    </i>
                                </div>
                                {true || truncatedReview.length ===
                                entry.review.length ? (
                                    entry.review
                                        .split("\n")
                                        .filter(Boolean)
                                        .map((p) => <p>{p}</p>)
                                ) : (
                                    <details>
                                        <summary title="expand review...">
                                            <span>
                                                <span>
                                                    {
                                                        truncateText(entry.review.split(
                                                            "\n",
                                                        )[0], 40)
                                                    }
                                                </span>
                                                <span>
                                                    ({countWords(entry.review)}{" "}
                                                    words)
                                                </span>
                                            </span>
                                        </summary>
                                        {entry.review
                                            .split("\n")
                                            .filter(Boolean)
                                            .map((p) => (
                                                <p>{p}</p>
                                            ))}
                                    </details>
                                )}
                            </li>
                        );
                    })
                }
            </ul>
        </main>
    </body>
</html>

<style>
    ul {
        width: 55ch;
        max-width: 90vw;
        margin-inline: max(5vw, calc(50vw - 55ch / 2));
        list-style: none;
        padding: unset;
    }

    li {
        max-width: 90ch;
        margin-top: 50px;
    }

    details:open summary {
        display: none;
    }

    details > summary,
    details p:first-of-type {
        margin-top: unset;
    }

    details summary::marker {
        color: #222222;
        transition: color 0.2s;
    }

    details summary:hover::marker {
        color: #6fbc57;
    }

    details {
        overflow-x: clip;
    }

    details summary {
        cursor: pointer;
        display: block;
    }

    details summary:hover {
        opacity: 0.5;
    }

    details summary > span {
        display: flex;
        justify-content: space-between;
    }

    details p {
        line-height: 1.4;
    }

    .header {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 2px dotted black;
    }

    .date {
        text-align: right;
    }

    h2 {
        margin: unset;
    }
</style>
